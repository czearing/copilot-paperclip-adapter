{
  "name": "copilot-paperclip-adapter",
  "version": "0.1.0",
  "description": "GitHub Copilot CLI adapter for Paperclip (local, headless, per-agent COPILOT_HOME isolation).",
  "license": "MIT",
  "author": "Caleb Zearing",
  "repository": {
    "type": "git",
    "url": "https://github.com/czearing/copilot-paperclip-adapter.git"
  },
